{
  "name": "@octanium91/ua-parser",
  "version": "1.1.7",
  "description": "JavaScript client for the Universal User-Agent Parser: Node.js (native Go core via koffi, WASM fallback on musl) and browser/SPA (WebAssembly)",
  "main": "lib/index.js",
  "browser": {
    "koffi": false,
    "path": false,
    "fs": false
  },
  "files": [
    "lib/index.js",
    "lib/*.so",
    "lib/*.dll",
    "lib/*.dylib",
    "lib/*.wasm",
    "lib/ua-parser-js.wasm",
    "lib/wasm_exec.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "user-agent",
    "parser",
    "client-hints",
    "ffi",
    "wasm",
    "browser"
  ],
  "author": "uaparser",
  "license": "Apache-2.0",
  "dependencies": {
    "koffi": "^2.15.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octanium91/ua-parser.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
