# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.wasm

# Stray extensionless build outputs of the wasm/wasmjs commands
# (`go build ./cmd/wasm` without -o drops a "wasm"/"wasmjs" binary at the root)
/wasm
/wasmjs
/server

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Generated resources
pkg/core/resources/regexes.json
/clients/node/node_modules/
/clients/node/package-lock.json

# Comparison harness artifacts (tools/compare)
/tools/compare/node/node_modules/
/tools/compare/out/
/tools/compare/java/target/

# Java client build output
/clients/java/target/

# Python bytecode cache
__pycache__/
*.pyc
